{
  "name": "react-router-custom",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "config": "pnpm i",
    "config:off": "pnpm run config --offline",
    "build:server": "tsc --outDir dist",
    "watch:server": "tsc --outDir dist --watch",
    "build:client": "esbuild --bundle ./src/entry.client.tsx --outdir=public/js --sourcemap",
    "watch:client": "esbuild --bundle ./src/entry.client.tsx --outdir=public/js --sourcemap --watch",
    "dev": "concurrently 'pnpm run watch:server' 'pnpm run watch:client' 'node --watch ./dist/index.js'",
    "build": "pnpm run build:server && pnpm run build:client && node ./dist/index.js",
    "start": "pnpm run build && node ./dist/index.js",
    "upgrade": "pnpm upgrade --latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mjackson/node-fetch-server": "^0.5.0",
    "@types/react": "^19.0.2",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "tsimp": "^2.0.12",
    "typescript": "^5.7.2"
  }
}
